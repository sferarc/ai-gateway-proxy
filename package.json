{
	"name": "ai-gateway-proxy",
	"version": "0.14.1",
	"description": "Forwards AI SDK gateway calls to the Vercel AI Gateway, with API key or Vercel OIDC authentication and request hooks",
	"keywords": [
		"ai",
		"ai-sdk",
		"ai-gateway",
		"vercel",
		"proxy",
		"oidc",
		"vercel-ai-gateway",
		"nextjs",
		"hono",
		"express",
		"route-handler",
		"streaming",
		"llm",
		"metering",
		"hooks"
	],
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sferarc/ai-gateway-proxy.git"
	},
	"homepage": "https://github.com/sferarc/ai-gateway-proxy#readme",
	"bugs": "https://github.com/sferarc/ai-gateway-proxy/issues",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist/**"
	],
	"scripts": {
		"build": "bunchee",
		"dev": "bunchee --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run src/integration.test.ts",
		"is-tree-shakable": "is-tree-shakable",
		"attw": "attw --pack .",
		"typecheck": "tsc --noEmit",
		"typecheck:example": "pnpm --filter ./examples/nextjs typecheck",
		"lint": "biome check .",
		"fix": "biome check --write .",
		"knip": "knip",
		"check": "pnpm lint && pnpm exec lefthook validate && pnpm knip && pnpm typecheck && pnpm test && pnpm build && pnpm typecheck:example && pnpm is-tree-shakable && pnpm attw",
		"changeset": "changeset",
		"release": "pnpm build && changeset publish"
	},
	"dependencies": {
		"@ai-sdk/provider": "catalog:",
		"@ai-sdk/provider-utils": "catalog:",
		"@vercel/oidc": "catalog:"
	},
	"devDependencies": {
		"@ai-sdk/gateway": "catalog:",
		"@arethetypeswrong/cli": "catalog:",
		"@biomejs/biome": "catalog:",
		"@changesets/cli": "catalog:",
		"@types/node": "catalog:",
		"@typescript/typescript6": "catalog:",
		"ai": "catalog:",
		"bunchee": "catalog:",
		"dotenv": "catalog:",
		"hono": "catalog:",
		"is-tree-shakable": "catalog:",
		"knip": "catalog:",
		"lefthook": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"packageManager": "pnpm@12.14.0"
}
